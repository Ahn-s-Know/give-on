{
  "name": "give-on",
  "version": "0.1.0",
  "description": "Give On — 기후변화로부터 생명을 지키는 AI 플랫폼",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "turbo dev",
    "dev:user": "turbo dev --filter=@give-on/user-web",
    "dev:admin": "turbo dev --filter=@give-on/admin-web",
    "build": "turbo build",
    "storybook": "storybook dev -p 6006 --ci",
    "build-storybook": "CI=true storybook build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@tailwindcss/vite": "^4.1.7",
    "storybook": "^8.6.18",
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "pnpm": "^11.0.9"
  }
}
