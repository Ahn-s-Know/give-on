{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@give-on/api": ["packages/api/src/index.ts"],
      "@give-on/forms": ["packages/forms/src/index.ts"],
      "@give-on/mocks": ["packages/mocks/src/index.ts"],
      "@give-on/schemas": ["packages/schemas/src/index.ts"],
      "@give-on/store": ["packages/store/src/index.ts"],
      "@give-on/theme/*": ["packages/theme/*"],
      "@give-on/ui": ["packages/ui/src/index.ts"]
    }
  }
}

